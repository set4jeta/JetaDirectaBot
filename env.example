# Configuración de JetaDirectaBot. Copia este fichero a `.env` y rellena.
#
#     cp env.example .env
#
# `.env` está en `.gitignore` y no debe subirse nunca. Este fichero sí se sube,
# así que aquí no va ningún valor real: solo el nombre, para qué sirve y el
# valor por defecto que usa `config.py` si la variable no está.
#
# Casi todo es opcional. Lo único sin lo que el bot no arranca son las dos
# primeras: `config.missing_required()` las comprueba al inicio y el bot lo dice
# en el arranque en vez de fallar a media ejecución.
#
# En Render no se usa este fichero: las mismas variables se ponen en
# Environment > Environment Variables del servicio.


# =====================================================================
# 1. Obligatorio
# =====================================================================

# Clave de la API de Riot. La de desarrollo caduca cada 24 h; la de producción
# da 500 req/10s y 30000 req/10min y es la que hace falta para seguir 20 ligas.
#   https://developer.riotgames.com/
RIOT_API_KEY=

# Token del bot en el portal de Discord (Bot > Token). Si se filtra, se
# regenera ahí mismo: cualquiera con el token controla el bot.
#   https://discord.com/developers/applications
DISCORD_TOKEN=


# =====================================================================
# 2. Marca y enlaces públicos
# =====================================================================
#
# Estos cuatro salen en `/help`, en `/premium` y en la web generada. Van vacíos
# por defecto a propósito: `utils/branding.py` omite el enlace que no está en
# vez de enseñar uno roto, y `scripts/generar_web.py` pinta el botón apagado y
# avisa al final de la generación de cuáles faltan.
#
# Mientras `BOT_INVITE_URL` esté vacío, el botón "Añadir a Discord" de la web
# sale desactivado: es el único enlace que convierte, así que es el primero que
# hay que rellenar antes de publicar.

# Nombre del producto. Va incrustado en el descargo legal de Riot, que exige
# poner el nombre del producto en la plantilla.
BOT_NOMBRE=JetaDirectaBot

# Enlace de invitación (OAuth2 > URL Generator, con los scopes `bot` y
# `applications.commands`).
BOT_INVITE_URL=

# URL pública de la web. Es también el sitio canónico que usa la generación si
# no se pasa `--sitio`.
BOT_WEB_URL=

# Donde se aceptan donaciones. Riot nombra las donaciones, las suscripciones y
# el crowdfunding como formas aceptables de cobrar; una tienda de ventajas de
# juego no lo es.
BOT_DONATE_URL=

# Servidor de soporte.
BOT_SOPORTE_URL=


# =====================================================================
# 3. Ritmo del tracker
# =====================================================================

# Cada cuántos segundos se comprueba si alguna cuenta seguida está en partida.
# Es el techo del retardo del aviso, y el número que la web publica en
# `avisos.html` leyéndolo de aquí. Bajarlo no hace el aviso más rápido más allá
# de un punto: la partida tarda en aparecer en la API de Riot.
CHECK_GAMES_INTERVAL=30

# Peticiones simultáneas del tracker. Subirlo con la clave de desarrollo (20
# req/s) provoca 429 en cadena.
TRACKER_CONCURRENCY=12

# Modos y colas que se notifican. Por defecto solo Grieta (SoloQ 420, Flex 440,
# normales 400/430). Para incluir Arena:
#   TRACKER_MODES=CLASSIC,CHERRY
#   TRACKER_QUEUES=400,420,430,440,1750
TRACKER_MODES=CLASSIC
TRACKER_QUEUES=400,420,430,440

# Cuántas fichas de Infoplayers se refrescan por hora.
INFOPLAYERS_PER_HOUR=60

# Refrescar todos los datos al arrancar. En 0 el bot arranca en segundos; en 1
# tarda pero empieza con todo al día. Útil tras un despliegue largo.
STARTUP_REFRESH=0


# =====================================================================
# 4. Almacén de rangos (ranked_data.json)
# =====================================================================
#
# El tracker guarda el rango de los 10 participantes de cada partida detectada,
# rivales aleatorios incluidos, así que sin tope el fichero crece para siempre.
# Los dos límites de abajo son lo que lo mantiene en tamaño razonable.

# Días que se conserva un rango en disco. Un rango de hace un año no sirve.
RANK_DATA_MAX_AGE_DAYS=30

# Tope de entradas del almacén.
RANK_DATA_MAX_ENTRIES=4000

# Segundos que se da por bueno un rango cacheado sin volver a pedirlo (6 h).
RANK_CACHE_MAX_AGE=21600

# Cada cuánto, como máximo, se vuelca el almacén a disco. Sin esto cada
# escritura reescribía los 316 kB completos.
RANK_FLUSH_INTERVAL=30

# Refresco en segundo plano de los rangos de las cuentas seguidas, para que
# `!team` y `!ranking` respondan al instante. 1 = activado.
RANK_WARM=1
RANK_WARM_INTERVAL=300

# TTL de la caché de rangos en memoria.
RANKED_CACHE_TTL=120

# Reparación de PUUID obsoletos (Riot los rota). Cuentas por hora y peticiones
# simultáneas.
PUUID_REPAIR_BATCH=200
PUUID_REPAIR_CONCURRENCY=10


# =====================================================================
# 5. Reloj del espectador
# =====================================================================
#
# Solo son respaldo. `spectator-v5` manda `gameStartTime` (reloj real) y
# `gameLength` (reloj del espectador) juntos, así que el desfase se **mide**
# restándolos en vez de suponerlo; ver `utils/game_clock.py`. Estos valores
# entran cuando falta uno de los dos, típicamente en pantalla de carga.
#
# 180 es el valor oficial de Riot, pero medido con
# `scripts/probe_spectator_timing.py` sobre partidas reales el desfase llega a
# 206 s. Por eso el valor medido tiene prioridad.
SPECTATOR_DELAY=180

# Arena (cola 1750) va con bastante menos retraso: 60 s medidos.
SPECTATOR_DELAY_ARENA=90


# =====================================================================
# 6. DPM.lol (historial y campeones)
# =====================================================================
#
# No es la API de Riot: no comparte cupo con `RIOT_API_KEY`.

DPM_CONCURRENCY=8
DPM_HISTORY_TTL=300

# Partidas guardadas por cuenta. `!historial` enseña 10.
DPM_HISTORY_MATCHES=20

# Guardar solo los campos que usa el bot. Cada participante trae ~90 campos y
# solo se usan 6; con esto la caché baja de ~27 MB a ~3 MB. Pon 0 si alguna
# función nueva necesita el participante completo.
DPM_SLIM_HISTORY=1

DPM_PUUID_TTL=86400
DPM_CACHE_MAX=500
DPM_TIMEOUT=20.0

# Parche del que se sacan los pickrates por línea. Con un parche viejo faltan
# campeones: el fichero que había en el repo era del 15.14 y solo cubría 149.
DPM_PATCH=16.17

# Precalentamiento del historial: `!historial` tarda ~20 s en frío. Con esto una
# tarea de fondo mantiene la caché caliente por lotes.
HISTORIAL_WARM=1
HISTORIAL_WARM_INTERVAL=60


# =====================================================================
# 7. Red y registro
# =====================================================================

RIOT_REQUEST_TIMEOUT=15.0
RIOT_MAX_RETRIES=4

# Plataforma por defecto cuando no se especifica región.
RIOT_DEFAULT_PLATFORM=euw1

# DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Puerto del servidor de vida (`keep_alive.py`). Render, Heroku y Fly lo
# inyectan ellos; en local 8080 vale.
PORT=8080


# =====================================================================
# 8. Opcional: claves públicas y de terceros
# =====================================================================

# Clave pública que usa lolesports.com desde el navegador. No es un secreto,
# pero se saca del código para poder cambiarla sin editar nada. Tiene valor por
# defecto en `config.py`; solo hay que ponerla aquí si Riot la rota.
LOL_API_KEY=

# Clave web pública del proyecto de Firestore de lolesports. Igual que la
# anterior: tiene valor por defecto.
FIREBASE_API_KEY=

# Token OAuth de Twitch para deducir el ganador de un partido por el chat. Este
# **sí** es un secreto real. Sin él, esa función queda desactivada y el resto del
# bot funciona igual.
TWITCH_OAUTH_TOKEN=




